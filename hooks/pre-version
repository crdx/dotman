#!/bin/bash
set -euo pipefail

NEW_VERSION="$1"

if ! grep -q '^## \[Next\]$' CHANGELOG.md; then
    echo "CHANGELOG.md has no ## [Next] section" >&2
    exit 1
fi

sed -i "s/^## \[Next\]\$/&\n\n## [${NEW_VERSION}] - $(date +%F)/" CHANGELOG.md

sed -i "s/VERSION = .*/VERSION = '${NEW_VERSION}'/" lib/*/version.rb
bundle install

git add lib/*/version.rb Gemfile.lock CHANGELOG.md
if git diff --cached --quiet; then
    echo "Nothing to commit (files already committed)."
else
    git commit -m "Release v${NEW_VERSION}"
fi

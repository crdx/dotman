#!/bin/bash
set -euo pipefail

NEW_VERSION="$1"

if ! awk '
    /^## \[Next\]$/ { sections++; in_next = 1; next }
    in_next && /^## / { in_next = 0 }
    in_next && /^- / { has_entry = 1 }
    END { exit !(sections == 1 && has_entry) }
' CHANGELOG.md; then
    echo "CHANGELOG.md must contain one non-empty ## [Next] section" >&2
    exit 1
fi

sed -i "s/^## \[Next\]\$/&\n\n## [${NEW_VERSION}] — $(date +%F)/" CHANGELOG.md

sed -i "s/VERSION = .*/VERSION = '${NEW_VERSION}'/" lib/*/version.rb
bundle install

git add lib/*/version.rb Gemfile.lock CHANGELOG.md
if git diff --cached --quiet; then
    echo "Nothing to commit (files already committed)."
else
    git commit -m "Release v${NEW_VERSION}"
fi
